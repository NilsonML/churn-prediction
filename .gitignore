# ДРУГОЕ
# ============================================

# Огромные файлы
*.zip
*.tar.gz
*.rar
*.7z

# Дампы базы данных
*.sql
*.dump

# Временные файлы pandas
*.feather
*.parquet
*.hdf5
# Логи обучения CatBoost (создаются автоматически при каждом fit)
catboost_info/

